# ── Database (PostgreSQL: Supabase / Neon / Vercel Postgres) ──
# Pooled connection used by the app at runtime (serverless-friendly).
# Supabase: the "Transaction pooler" URL (port 6543). Neon: the "-pooler" host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"
# Direct (non-pooled) connection used only by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ── Auth ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="replace-with-a-long-random-string"

# ── Seed (npm run db:seed) ──
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="replace-me"
# Set to 1 to also create demo soldiers / items for local development.
SEED_DEMO="0"
