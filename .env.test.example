# Integration tests (npm run test:integration) DELETE all rows in this database.
# Use a throwaway Neon branch — never the production/main branch.
# Use the DIRECT (non-pooled) connection string: host WITHOUT "-pooler".
# After setting it, run once:  npm run test:mark-db   (inspect)  →  npm run test:mark-db -- --yes
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
