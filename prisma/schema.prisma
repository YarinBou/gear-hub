// Gear-Hub — Prisma schema
// Prisma 7: the connection URL lives in prisma.config.ts (migrations) and in
// src/lib/prisma.ts (runtime, via the pg driver adapter). Not in this file.
//
// Multi-company: every company-owned model carries `companyId`. Companies share nothing.
// App code reaches the database through scopedDb(companyId) (src/lib/db.ts), which adds the
// company to every query and rejects writes for another company. Keep SCOPED_MODELS there in sync.
//
// Deployments (הפעלות): the roster, catalog, physical items and storage belong to the company;
// who holds what (EquipmentAssignment), the personal kits and the ammo stock belong to one
// Deployment. A company has at most one ACTIVE deployment (partial unique index in the
// migration), possibly none. Closed deployments are kept as a read-only history.
// scopedDb(companyId, deploymentId) also filters DEPLOYMENT_MODELS by deployment.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  /// System operator: creates companies and their first admin. Belongs to no company.
  SUPER_ADMIN
  ADMIN // סמ"פ / מ"פ
  REGULAR // רס"פ / מ"מ
}

enum Platoon {
  PLATOON_1 // מחלקה 1
  PLATOON_2 // מחלקה 2
  PLATOON_3 // מחלקה 3
  HQ // חפ"ק ומפל"ג
}

enum DeploymentStatus {
  ACTIVE // פעילה
  CLOSED // הסתיימה — read-only history
}

/// Which module a catalog category belongs to.
enum CatalogDomain {
  EQUIPMENT // צל"ם — numbered items
  AMMUNITION // תחמושת
  STORAGE // ציוד פלוגתי בימ"ח
}

enum EquipmentStatus {
  IN_ARMORY // בנשקייה
  WITH_SOLDIER // אצל לוחם
  IN_REPAIR // בתיקון
  STORED // מאופסן
  MISSING // חסר
}

enum AmmoCategory {
  EXPLOSIVE // נפיצה
  NON_LETHAL // אלפ"ה
  STANDARD // רגילה
}

enum StorageStatus {
  OK // תקין
  SHORTAGE // חוסר
  DAMAGED // בלאי
  EXPIRED // פג תוקף
}

// ───────────────────────────── Companies (tenants) ─────────────────────────────

/// A company (פלוגה). Created by a SUPER_ADMIN together with its first admin.
model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  /// Deactivated companies can't sign in.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  deployments          Deployment[]
  equipmentAssignments EquipmentAssignment[]
  soldiers             Soldier[]
  categories           EquipmentCategory[]
  equipmentItems       EquipmentItem[]
  equipmentLogs        EquipmentLog[]
  ammoStocks           AmmoStock[]
  ammoLogs             AmmoLog[]
  personalKits         PersonalKit[]
  kitInspections       KitInspection[]
  storageItems         StorageItem[]
}

/// An operational deployment / mission (הפעלה), e.g. "עזה 2023". Holds who signed for what.
model Deployment {
  id              String           @id @default(cuid())
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name            String
  status          DeploymentStatus @default(ACTIVE)
  /// = companyId while ACTIVE, null once CLOSED. Its unique index allows at most one active
  /// deployment per company (kept consistent with status by a CHECK in the migration).
  activeCompanyId String?          @unique
  startedAt       DateTime         @default(now())
  endedAt         DateTime?
  createdById     String?
  createdBy       User?            @relation("DeploymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  assignments   EquipmentAssignment[]
  personalKits  PersonalKit[]
  ammoStocks    AmmoStock[]
  equipmentLogs EquipmentLog[]

  @@unique([companyId, name])
  @@index([companyId, status])
}

// ───────────────────────────── Users & roster ─────────────────────────────

model User {
  id           String   @id @default(cuid())
  /// Null only for SUPER_ADMIN.
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// Unique across all companies: we don't know the company until the user has signed in.
  username     String   @unique
  name         String
  passwordHash String
  role         Role     @default(REGULAR)
  /// Optional home platoon (e.g. a מ"מ). Null = company-wide.
  platoon      Platoon?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  equipmentLogs      EquipmentLog[]
  ammoLogs           AmmoLog[]
  kitInspections     KitInspection[]
  signedKits         PersonalKit[]   @relation("KitSignedBy")
  deploymentsCreated Deployment[]    @relation("DeploymentCreatedBy")

  @@index([companyId])
}

/// Login attempts, for rate limiting on serverless (in-memory counters don't survive across instances).
/// Failed attempts are cleared on successful login; rows older than a day are pruned.
/// Not company-scoped: login happens before we know the company.
model LoginAttempt {
  id        String   @id @default(cuid())
  /// Normalized (lowercased) username as typed — may not exist.
  username  String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

/// The company roster (סד"כ). Single source of truth for every assignment.
model Soldier {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name           String
  /// מספר אישי — unique within the company
  personalNumber String?
  phone          String?
  platoon        Platoon
  /// תפקיד (e.g. מטול, קשר, חובש)
  position       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments EquipmentAssignment[]
  /// One kit per deployment at most.
  kits        PersonalKit[]
  logsFrom    EquipmentLog[]        @relation("LogFromSoldier")
  logsTo      EquipmentLog[]        @relation("LogToSoldier")

  @@unique([companyId, personalNumber])
  @@index([companyId, platoon])
  @@index([companyId, name])
}

// ───────────────────────────── Catalog (per company) ─────────────────────────────

/// Dynamic, admin-managed types (weapon models, optics, ammo types, storage items…).
model EquipmentCategory {
  id             String        @id @default(cuid())
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  name           String
  domain         CatalogDomain
  description    String?
  /// Only for AMMUNITION.
  ammoCategory   AmmoCategory?
  /// Low-stock threshold (company-wide total). AMMUNITION only.
  minThreshold   Int?
  /// תקן — how many items of this type the company should hold. EQUIPMENT only.
  targetQuantity Int?
  /// STORAGE items that require expiry tracking (e.g. tourniquets, medical).
  requiresExpiry Boolean       @default(false)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  equipmentItems EquipmentItem[]
  ammoStocks     AmmoStock[]
  storageItems   StorageItem[]

  @@unique([companyId, domain, name])
}

// ───────────────────────────── Module B: צל"ם ─────────────────────────────

model EquipmentItem {
  id           String            @id @default(cuid())
  companyId    String
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// צ / מס"ט. Null = not recorded yet ("ללא צ"); unique within the company when present.
  serialNumber String?
  categoryId   String
  category     EquipmentCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  /// Linked set: this item is a component of `parent` (e.g. a ציין or קנס"פ of a נגב).
  /// Components always follow their parent's holder / status / platoon (in every deployment). One level only.
  parentId   String?
  parent     EquipmentItem?  @relation("ItemComponents", fields: [parentId], references: [id], onDelete: SetNull)
  components EquipmentItem[] @relation("ItemComponents")

  logs         EquipmentLog[]
  /// Holder / status / platoon of this item in each deployment.
  assignments  EquipmentAssignment[]
  /// Kits (one per deployment at most) where this item is the personal weapon.
  personalKits PersonalKit[]

  @@unique([companyId, serialNumber])
  @@index([parentId])
}

/// Where an item is in one deployment. Every item has a row in every deployment it existed in
/// (created when the deployment starts, or when the item is added during it).
/// All changes go through applyAssignment() in src/lib/equipment-service.ts.
model EquipmentAssignment {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  deploymentId   String
  deployment     Deployment      @relation(fields: [deploymentId], references: [id], onDelete: Restrict)
  itemId         String
  item           EquipmentItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  status         EquipmentStatus @default(IN_ARMORY)
  soldierId      String?
  soldier        Soldier?        @relation(fields: [soldierId], references: [id], onDelete: SetNull)
  /// Auto-filled from the soldier; can also be set directly for platoon-level bulk assignment.
  platoon        Platoon?
  lastVerifiedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([deploymentId, itemId])
  @@index([deploymentId, status])
  @@index([deploymentId, soldierId])
  @@index([deploymentId, platoon])
  @@index([deploymentId, lastVerifiedAt])
  @@index([itemId])
}

/// Digital history of assignments / status changes (יומן העברות).
model EquipmentLog {
  id            String           @id @default(cuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// The deployment the change happened in (null: outside any deployment, e.g. intake).
  deploymentId  String?
  deployment    Deployment?      @relation(fields: [deploymentId], references: [id], onDelete: Restrict)
  itemId        String
  item          EquipmentItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromSoldierId String?
  fromSoldier   Soldier?         @relation("LogFromSoldier", fields: [fromSoldierId], references: [id], onDelete: SetNull)
  toSoldierId   String?
  toSoldier     Soldier?         @relation("LogToSoldier", fields: [toSoldierId], references: [id], onDelete: SetNull)
  fromStatus    EquipmentStatus?
  toStatus      EquipmentStatus?
  platoon       Platoon?
  note          String?
  performedById String?
  performedBy   User?            @relation(fields: [performedById], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())

  @@index([itemId, createdAt])
  @@index([companyId])
  @@index([deploymentId])
}

// ───────────────────────────── Module C: תחמושת ─────────────────────────────

model AmmoStock {
  id            String            @id @default(cuid())
  companyId     String
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  deploymentId  String
  deployment    Deployment        @relation(fields: [deploymentId], references: [id], onDelete: Restrict)
  categoryId    String
  category      EquipmentCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// מיקום (e.g. בונקר פלוגתי, מחלקה 2, רכב מבצעי)
  location      String
  quantity      Int               @default(0)
  lastCountedAt DateTime?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  logs AmmoLog[]

  @@unique([deploymentId, categoryId, location])
  @@index([companyId])
}

enum AmmoLogType {
  COUNT // ספירה — quantity set to the counted amount
  RECEIVE // קליטה — added
  ISSUE // ניפוק — subtracted
}

/// Accountability trail for every ammunition quantity change.
model AmmoLog {
  id               String      @id @default(cuid())
  companyId        String
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  stockId          String
  stock            AmmoStock   @relation(fields: [stockId], references: [id], onDelete: Cascade)
  type             AmmoLogType
  /// The amount entered (counted quantity for COUNT, delta for RECEIVE / ISSUE).
  amount           Int
  previousQuantity Int
  newQuantity      Int
  note             String?
  performedById    String?
  performedBy      User?       @relation(fields: [performedById], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())

  @@index([stockId, createdAt])
  @@index([companyId])
}

// ───────────────────────────── Module D: ציוד אישי והחתמות ─────────────────────────────

/// One of the 98 personal combat kits of a deployment — the digital sign-out form.
/// Boolean fields are "present / signed for". Keep KIT_ITEMS in src/lib/kit.ts in sync.
model PersonalKit {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Restrict)
  /// 1–98 (range enforced in the app layer), unique within the deployment
  kitNumber    Int
  soldierId    String?
  soldier      Soldier?   @relation(fields: [soldierId], references: [id], onDelete: SetNull)

  // נשק אישי
  personalWeaponId String?
  personalWeapon   EquipmentItem? @relation(fields: [personalWeaponId], references: [id], onDelete: SetNull)
  /// e.g. M16 / M4 (free text, kept even without a linked serial item)
  rifleType        String?
  weaponIssued     Boolean        @default(false)
  magazineCount    Int            @default(0)
  ammoCount        Int            @default(0)

  // כלי ניקוי ונשק
  cleaningKit Boolean @default(false)
  weaponSling Boolean @default(false)
  weaponOil   Boolean @default(false)

  // ציוד אישי ללוחם (כולל חורף)
  uniform1        Boolean @default(false)
  uniform2        Boolean @default(false)
  workBelt        Boolean @default(false)
  sleepingBag     Boolean @default(false)
  tacticalEyewear Boolean @default(false)
  kneePads        Boolean @default(false)
  gearBag90L      Boolean @default(false)
  tacticalVest    Boolean @default(false)
  ceramicPlates   Boolean @default(false)
  helmet          Boolean @default(false)
  catTourniquet   Boolean @default(false)
  headlamp        Boolean @default(false)

  // החתמה
  signedAt        DateTime?
  signedById      String?
  signedBy        User?     @relation("KitSignedBy", fields: [signedById], references: [id], onDelete: SetNull)
  /// Data-URL / blob URL of the soldier's drawn signature.
  signatureData   String?
  lastInspectedAt DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  inspections KitInspection[]

  @@unique([deploymentId, kitNumber])
  @@unique([deploymentId, soldierId])
  @@unique([deploymentId, personalWeaponId])
  @@index([companyId])
}

/// A physical inspection (מסדר) snapshot.
model KitInspection {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  kitId         String
  kit           PersonalKit @relation(fields: [kitId], references: [id], onDelete: Cascade)
  /// Keys of KIT_ITEMS found missing during this inspection.
  missingItems  String[]
  performedById String?
  performedBy   User?       @relation(fields: [performedById], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime    @default(now())

  @@index([kitId, createdAt])
  @@index([companyId])
}

// ───────────────────────────── Module E: ציוד פלוגתי בימ"ח ─────────────────────────────

model StorageItem {
  id              String            @id @default(cuid())
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  categoryId      String
  category        EquipmentCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// תקן
  targetQuantity  Int               @default(0)
  /// מצאי
  currentQuantity Int               @default(0)
  status          StorageStatus     @default(OK)
  /// For items that expire (tourniquets / medical). Nearest expiry in the batch.
  expiryDate      DateTime?
  location        String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([companyId])
  @@index([expiryDate])
}
